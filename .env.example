# Copy to .env and adjust.
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
ASSETS_DIR=./assets
COOKIE_SECURE=false
SESSION_TTL_DAYS=365
TRUST_PROXY=0
# The household's time zone: "today" for modules starts at midnight here.
TZ=Europe/Warsaw
# Docker Compose only: the image version to run, for example 1.2.3 (the newest one when empty).
HOMEDEX_VERSION=
